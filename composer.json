{
    "name": "yireo/magento2-backend-reindexer",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "version": "1.0.1",
    "homepage": "https://github.com/yireo/magento2-backend-reindexer",
    "description": "Magento 2 module to add reindexing to the Admin Panel",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "require": {
        "magento/framework": "^100.1|^101.0|^102.0|^103.0",
        "magento/module-backend": "^100.1|^101.0|^102.0",
        "magento/module-indexer": "^100.4",
        "php": ">=8.2 <8.6",
        "psr/log": "^1 || ^2 || ^3"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\BackendReindexer\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "require-dev": {
        "yireo/magento2-integration-test-helper": "~0.0"
    }
}